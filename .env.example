# ===== GHENNAI — متغيرات بيئة النشر السحابي =====
# انسخ هذه الملف إلى .env واملأ القيم، أو ضعها في متغيرات المنصة (Render/Railway).
# لا تُرفع أي مفاتيح إلى git/image — المنصة تتلقاها مباشرة.

# البوابة الرئيسية (Render/Railway تحددها تلقائيًا)
PORT=3001

# ===== الذكاء — مفتاح واحد أو أكثر (الأقوى أولًا) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ترتيب أولوية الجودة ثم الاحتياط
PROVIDER_PRIORITY=gemini,groq,openrouter,openai,anthropic
TOOL_PRIORITY=openrouter,groq,openai
CLOUD_HEADSTART_MS=15000
CLOUD_TIMEOUT_MS=40000

# ===== أدوات خارجية (اختياري) =====
SERPER_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
GOOGLE_STT_API_KEY=

# ===== أمان =====
JWT_SECRET=change-me-to-a-long-random-string