  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "check": "tsc --noEmit",
    "lint": "eslint src server --max-warnings 1000",
    "format": "prettier --write \"./{src,server}/**/*.{ts,tsx,js}\"",
    "test:headless": "node tests/headless.mjs",
    "test:brain": "node tests/headless-brain.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "start": "node server/index.js"
  }
